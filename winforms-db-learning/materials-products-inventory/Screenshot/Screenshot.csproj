<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Screenshot harness, not part of the shipped app. Constructs MainForm the same
    way Program.cs does (minus starting the message loop) and renders it to a PNG
    via DrawToBitmap. Usage: dotnet run, output path as arg.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MaterialsProductsInventory.Screenshot</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinFormsGid.csproj" />
  </ItemGroup>

</Project>
